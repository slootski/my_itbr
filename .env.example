# IBKR Flex Web Service credentials.
# Generate in IBKR Account Management -> Reporting -> Flex Web Service.
# Define a Flex Query (positions + trades + cash report sections) to get the query id.
FLEX_TOKEN=your_flex_token_here
FLEX_QUERY_ID=your_flex_query_id_here

# Local SQLite store for NAV snapshots and the trade / cash-transaction archive.
# This is the only copy of history older than IBKR's rolling 365-day Flex window.
DB_PATH=db/snapshots.sqlite

# Rotating backups of that store: one per refresh-day, oldest pruned past KEEP.
# Same-disk backups only guard against accidental deletion and corruption — point
# BACKUP_DIR at a synced folder or external volume to also survive losing the Mac,
# e.g. ~/Library/Mobile Documents/com~apple~CloudDocs/ibkr-backups
BACKUP_DIR=db/backups
BACKUP_KEEP=14

# Optional: Polygon.io API key for real declared-dividend amounts on held
# tickers IBKR Flex has no data on yet (free key at https://polygon.io).
# Unset -> falls back to yfinance ex/pay dates only (no amounts).
POLYGON_API_KEY=
